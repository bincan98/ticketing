# All local backups and old distribution files stay on this PC.
/.*-backup-*/
/ticket-click-extension*.zip
/popup-*-preview.*
/.env
/.env.*
*.pem
*.key

# Local development history and diagnostics are not public release sources.
/README.md
/VERIFICATION.md
/CHANGE_PLAN.md
/NOL_DOM_NOTES.md
/PRACTICKET_DOM_NOTES.md

# Track reproducible test code and fixtures, not generated reports or profiles.
/tests/*
!/tests/*.test.cjs
!/tests/*.js
!/tests/*.html
!/tests/temporary-profile.cjs
!/tests/server.cjs
